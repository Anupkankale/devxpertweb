# Contact form delivery (https://web3forms.com, free). Without it, the form falls back to opening the visitor's email app.
NUXT_PUBLIC_WEB3FORMS_KEY=

# Canonical site URL (defaults to https://devxpertlabs.com)
# NUXT_PUBLIC_SITE_URL=https://devxpertlabs.com

# Set to false for staging/preview builds to noindex the whole site
# NUXT_PUBLIC_INDEXABLE=true
